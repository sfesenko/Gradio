# Builds from the current work tree, including uncommitted changes.
# source=() is empty, so prepare() copies the tree into $srcdir; makepkg -C
# wipes only that copy.

pkgname=gradio
pkgver=8.0.0
pkgrel=1
pkgdesc="Internet radio player for GTK4 with Google Cast support"
arch=('x86_64')
url="https://github.com/sfesenko/Gradio"
license=('GPL-3.0-or-later')
depends=(
    'gtk4'
    'glib2'
    'libsoup3'
    'json-glib'
    'gstreamer'
    'gdk-pixbuf2'
    'hicolor-icon-theme'

    'gst-plugins-base'
    'gst-plugins-good'
    'gst-plugins-bad'
)
makedepends=('meson' 'ninja' 'vala' 'gettext')
source=()
sha256sums=()

# Copy the work tree into $srcdir/$pkgname.
prepare() {
    local source_dir
    if [[ -n "${GRADIO_SOURCE_DIR:-}" ]]; then
        source_dir="$GRADIO_SOURCE_DIR"
    elif [[ -n "${PKGBUILD_DIR:-}" ]]; then
        source_dir="$PKGBUILD_DIR/.."
    elif [[ -n "${startdir:-}" ]]; then
        if [[ "$(basename "$startdir")" == "dist" ]]; then
            source_dir="$startdir/../.."
        else
            source_dir="$startdir/.."
        fi
    else
        source_dir="$(dirname "${BASH_SOURCE[0]:-.}")/.."
    fi
    source_dir="$(realpath "$source_dir")"

    # Refuse to run if $srcdir overlaps the real sources.
    if [[ "$(realpath "$startdir")" == "$source_dir" ]] \
       || [[ -n "$(find "$srcdir" -maxdepth 1 -name '*.vala' 2>/dev/null)" ]]; then
        error "Refusing to build: \$srcdir ($srcdir) contains real sources."
        return 1
    fi

    rm -rf "$srcdir/$pkgname"
    mkdir -p "$srcdir/$pkgname"
    tar -C "$source_dir" \
        --exclude-vcs \
        --exclude='./builddir' \
        --exclude='./_build' \
        --exclude='./build-*' \
        --exclude='./scripts/dist' \
        --exclude='./scripts/pkg' \
        --exclude='./scripts/src' \
        -cf - . \
        | tar -C "$srcdir/$pkgname" -xf -
}

build() {
    cd "$srcdir/$pkgname"
    meson setup builddir --prefix=/usr --buildtype=release
    meson compile -C builddir
}

check() {
    cd "$srcdir/$pkgname"
    meson test -C builddir
}

package() {
    cd "$srcdir/$pkgname"
    DESTDIR="$pkgdir" meson install -C builddir
}
